PORT=3000
NODE_ENV=development
API_PREFIX=api/v1
# Project-owned Docker PostgreSQL; keep its password in your ignored .env.
DATABASE_URL=postgresql://pulse@127.0.0.1:5436/pulse
PGPASSWORD=
# Local Docker inbox: SMTP 1026, browser inbox http://localhost:8026.
SMTP_HOST=127.0.0.1
SMTP_PORT=1026
SMTP_SECURE=false
SMTP_FROM=Pulse <no-reply@pulse.test>
STAFF_WEB_ORIGIN=http://localhost:3001
# Generate independently per environment; keep the value in ignored .env.
STAFF_RECOVERY_MAIL_KEY=
# Adult positive-screening rules: enabled by default in development/test only.
# Production requires clinical review before explicit enablement.
# PULSE_VITAL_SCREENING_ENABLED=true
