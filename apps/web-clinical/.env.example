# API origin includes the version prefix. Tokens and this key remain server-only.
PULSE_API_BASE_URL=http://localhost:3000/api/v1
# Generate independently per environment: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
PULSE_SESSION_SECRET=
# Behind a reverse proxy, use the explicit public HTTPS origin here.
PULSE_APP_ORIGIN=http://localhost:3001
